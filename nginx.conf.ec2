# Nginx configuration for Candiq-AI on EC2
# Place this file at: /etc/nginx/sites-available/candiq-ai
# Server IP: 3.103.97.187

server {
    listen 80;
    server_name 3.103.97.187;  # Your EC2 IP address
    
    # If you have a domain name, replace the IP above with your domain
    # server_name your-domain.com;
    
    # Redirect HTTP to HTTPS (uncomment after setting up SSL)
    # return 301 https://$server_name$request_uri;

    # AI endpoints need longer timeout (5 minutes for question generation)
    location ~ ^/api/projects/[0-9]+/(generate-questions|regenerate-questions|refine|analyze-time) {
        proxy_pass http://localhost:5000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
        proxy_set_header Cookie $http_cookie;
        proxy_cookie_path / /;
        
        # Extended timeouts for AI operations (5 minutes)
        proxy_connect_timeout 300s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
    }

    # For initial setup without SSL, use this:
    location / {
        proxy_pass http://localhost:5000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
        
        # Critical: Forward cookies properly
        proxy_set_header Cookie $http_cookie;
        proxy_cookie_path / /;
        
        # Standard timeouts (3 minutes)
        proxy_connect_timeout 180s;
        proxy_send_timeout 180s;
        proxy_read_timeout 180s;
    }

    # Increase body size for file uploads
    client_max_body_size 50M;
}

